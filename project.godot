; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="سرزمین مادری — Sarzamin-e Madari"
config/description="Bad North–style island defense — Achaemenid Persia vs Greek invaders. دفاع از جزیره در روزگار هخامنشیان."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameEvents="*res://scripts/core/GameEvents.gd"
PathService="*res://scripts/pathfinding/PathService.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

